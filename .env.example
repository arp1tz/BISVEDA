# ==============================================================================
# BISVEDA V8 — Environment Configuration
# ==============================================================================

# 1. LLM INFERENCE (Provide at least ONE for dynamic generative reasoning)
# ------------------------------------------------------------------------------
# Groq (Recommended: ultra-low latency Llama-3.3-70b & Llama-3.1-8b router)
# Get key: https://console.groq.com
GROQ_API_KEY=

# Google Gemini (Recommended for Multimodal Product Label & ISI Mark vision inspection)
# Get key: https://aistudio.google.com
GEMINI_API_KEY=

# OpenAI (Alternative fallback for reasoning & embeddings)
# Get key: https://platform.openai.com
OPENAI_API_KEY=

# 2. INDIC LANGUAGE TRANSLATION (Optional: GoI Bhashini Mission)
# ------------------------------------------------------------------------------
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# 3. EXTERNAL WEB SEARCH (Optional fallback for latest live notifications)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=

# 4. RUNTIME SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
ENVIRONMENT=development
GENERATION_ENABLED=true
HOSTED_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
HOSTED_FAST_MODEL=groq/llama-3.1-8b-instant
HOSTED_VISION_MODEL=gemini/gemini-1.5-flash
RELEVANCE_FLOOR=0.45
PORT=8000
