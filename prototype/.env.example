# BISVEDA Prototype Environment Variables
GROQ_API_KEY=
# Optional model overrides (defaults are set in src/lib/llm.ts)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_STT_MODEL=whisper-large-v3
GEMINI_API_KEY=
# Vision model for photo checks (fastest measured on 2026-09-29):
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Local embeddings (no key). Changing either value requires re-embedding every chunk.
# EMBED_MODEL=Xenova/bge-m3
# EMBED_DTYPE=fp32
OPENAI_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Knowledge base (R1): PostgreSQL via docker-compose (npm run db:up, db:migrate, db:import)
# DATABASE_URL=postgres://bisveda:bisveda_dev@127.0.0.1:5432/bisveda
# KB_SOURCE=db          # "json" reads data/kb/*.json instead (offline fallback / parity checks)
# ADMIN_PASSWORD=       # set this; the code still has a dev default until R6
